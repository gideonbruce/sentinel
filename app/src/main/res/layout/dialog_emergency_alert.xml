<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="24dp">

    <!-- Emergency Icon -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:src="@android:drawable/ic_dialog_alert"
        android:contentDescription="Emergency icon" />

    <!-- Title -->
    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/emergency_alerttttttttt"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#212529"
        android:gravity="center"
        android:fontFamily="sans-serif-medium" />

    <!-- Contact Info -->
    <TextView
        android:id="@+id/dialog_contact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/to_emergency_contact"
        android:textSize="14sp"
        android:textColor="#6C757D"
        android:gravity="center" />

    <TextView
        android:id="@+id/dialog_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="FF5722"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginTop="8dp"/>

    <!-- Message/Loading Container -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:minHeight="80dp">

        <!-- Loading Progress -->
        <ProgressBar
            android:id="@+id/loading_progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerHorizontal="true"
            android:visibility="gone" />

        <!-- Message Text -->
        <TextView
            android:id="@+id/dialog_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/send_emergency_alert_now_popup"
            android:textSize="16sp"
            android:textColor="#212529"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

        <!-- Preview Label (hidden initially) -->
        <TextView
            android:id="@+id/dialog_preview_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/message_preview"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#6C757D"
            android:visibility="gone"
            android:paddingBottom="8dp" />

        <!-- Preview Text (hidden initially) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/dialog_preview_label"
            android:maxHeight="120dp">

            <TextView
                android:id="@+id/dialog_preview_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="14sp"
                android:textColor="#212529"
                android:background="#F5F5F5"
                android:padding="12dp"
                android:visibility="gone"
                android:lineSpacingExtra="2dp" />
        </ScrollView>
    </RelativeLayout>

    <!-- Buttons Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Cancel Button -->
        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/cancel"
            android:textSize="16sp"
            android:textColor="#212529"
            android:background="@android:color/transparent"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium" />

        <!-- Send Button -->
        <Button
            android:id="@+id/btn_send"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/send_alert"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:background="#DC3545"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
</LinearLayout>